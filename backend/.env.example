PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/healthcare_marketplace
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DEFAULT_ADMIN_EMAIL=admin@healthcare.com
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password_here

# Firebase Admin SDK Credentials (Authentication Provider)
FIREBASE_PROJECT_ID=carepulse-healthcare
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@carepulse-healthcare.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Rate Limiting Configuration (All Configurable)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP_WINDOW_MS=900000
RATE_LIMIT_AUTH_IP_MAX=30
RATE_LIMIT_AUTH_ACCOUNT_MAX_FAILURES=3
RATE_LIMIT_AUTH_ACCOUNT_BASE_DELAY_SEC=5
RATE_LIMIT_AUTH_ACCOUNT_FACTOR=2
RATE_LIMIT_AUTH_ACCOUNT_MAX_DELAY_SEC=300
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MS=900000

RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=150

RATE_LIMIT_AUTH_USER_WINDOW_MS=900000
RATE_LIMIT_AUTH_USER_MAX=1000

